# ─── Autenticação (Auth.js) ───────────────────────────────
# Gere um segredo aleatório: rode  npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=

# ─── Google OAuth (Google Cloud Console) ──────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Discord OAuth + Bot (Discord Developer Portal) ───────
AUTH_DISCORD_ID=          # = Application ID / Client ID (pode ser público)
AUTH_DISCORD_SECRET=      # Client Secret  (NUNCA compartilhe / NUNCA no chat)
DISCORD_BOT_TOKEN=        # Bot Token       (NUNCA compartilhe / NUNCA no chat)
DISCORD_PUBLIC_KEY=       # Public Key (Developer Portal > General Information) - para os slash commands

# Público (usado pra montar o link de adicionar o bot no navegador)
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# (Opcional) e-mail do dono, com acesso ao /comandos. Se vazio, usa o padrão do código.
# IA (Google AI Studio - free): interpretação inteligente do texto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OWNER_EMAIL=

# ─── URL do app ───────────────────────────────────────────
# Local: http://localhost:3000   |   Vercel: https://SEU-APP.vercel.app
NEXTAUTH_URL=http://localhost:3000
